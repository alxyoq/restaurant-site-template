{
  "name": "restaurant-site-template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --turbopack",
    "prebuild": "npm run validate:automation",
    "build": "next build",
    "postbuild": "npm run verify:preview",
    "build:netlify": "npm run audit:production && npm run test:automation && npm run check && npm run build",
    "start": "next start",
    "check": "biome check src && tsc --noEmit",
    "validate:automation": "node scripts/validate-automation.mjs",
    "test:automation": "node --test scripts/validate-automation.test.mjs",
    "verify:preview": "node scripts/verify-preview.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=critical",
    "lint": "biome lint src",
    "format": "biome format --write src"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "15.5.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
